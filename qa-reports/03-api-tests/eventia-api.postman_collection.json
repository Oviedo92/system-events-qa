              "raw": "{{baseUrl}}/events/{{eventId}}/ticket-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "ticket-types"
              ]
            }
          }
        }
