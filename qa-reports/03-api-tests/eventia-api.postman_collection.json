      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request Script global: adjunta el Bearer Token automáticamente si existe y no se omitió",
          "const skipAuth = pm.request.headers.has(\u0027X-Skip-Auth\u0027);",
          "if (skipAuth) {",
          "    pm.request.headers.remove(\u0027X-Skip-Auth\u0027);",
          "} else {",
          "    const token = pm.environment.get(\u0027authToken\u0027);",
          "    if (token) {",
          "        pm.request.headers.upsert({ key: \u0027Authorization\u0027, value: \u0027Bearer \u0027 + token });",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Umbral SLA de rendimiento Entregable 6: \u003c 500ms consultas (GET), \u003c 1000ms escrituras (POST/PATCH/DELETE)",
          "const httpMethod = pm.request.method.toUpperCase();",
          "const slaLimitMs = httpMethod === \"GET\" ? 500 : 1000;",
          "pm.test(\"[SLA Rendimiento] \" + httpMethod + \" responde en menos de \" + slaLimitMs + \" ms (actual: \" + pm.response.responseTime + \" ms)\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(slaLimitMs);",
          "});"
        ]
      }
    }
