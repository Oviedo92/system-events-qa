    {
      "name": "05 - Data-Driven Testing (CSV)",
      "item": [
        {
          "name": "05.1 Create TicketType from CSV Dataset",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si se ejecuta fuera de runner sin CSV, usa valores por defecto",
                  "if (!pm.iterationData.has(\u0027expectedStatus\u0027)) {",
                  "    pm.variables.set(\u0027name\u0027, \u0027Entrada General CSV Fallback\u0027);",
                  "    pm.variables.set(\u0027description\u0027, \u0027Prueba unitaria sin iteracion CSV\u0027);",
                  "    pm.variables.set(\u0027price\u0027, 50000);",
                  "    pm.variables.set(\u0027quantity\u0027, 100);",
                  "}",
                  "if (!pm.environment.get(\u0027eventId\u0027)) {",
                  "    pm.environment.set(\u0027eventId\u0027, 1);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectedStatus = Number(pm.iterationData.get(\u0027expectedStatus\u0027) || 201);",
                  "pm.test(`Status code coincide con CSV esperado (${expectedStatus})`, () =\u003e {",
                  "    pm.response.to.have.status(expectedStatus);",
                  "});",
                  "pm.test(\u0027Content-Type es application/json\u0027, () =\u003e pm.expect(pm.response.headers.get(\u0027Content-Type\u0027)).to.include(\u0027application/json\u0027));",
                  "pm.test(\u0027Tiempo de respuesta menor a 2000ms\u0027, () =\u003e pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const json = pm.response.json();",
                  "pm.test(\u0027Body valida resultado según caso CSV\u0027, () =\u003e {",
                  "    if (expectedStatus === 201) {",
                  "        pm.expect(json.id).to.be.a(\u0027number\u0027);",
                  "    } else {",
                  "        pm.expect(json.message).to.exist;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"description\": \"{{description}}\",\n  \"price\": {{price}},\n  \"quantity\": {{quantity}}\n}"
            },
